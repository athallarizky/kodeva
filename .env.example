# Neon Postgres — pakai connection string POOLED (host -pooler, port 6543) untuk Vercel serverless
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret acak min. 32 karakter (generate: openssl rand -hex 32)
PAYLOAD_SECRET=

# URL publik aplikasi (tanpa trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret untuk endpoint cron (opsional, bonus scheduling)
CRON_SECRET=
